{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The Worker-native chat module is typechecked with src/; see src/native-chat-api.ts.
    "paths": { "ocx-worker-native": ["./src/native-chat-api.ts"] }
  },
  "include": ["src"]
}
